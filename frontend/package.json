{
  "name": "hestia-panel",
  "version": "0.1.16",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "ng build",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test --test-concurrency=1 tests/browser/geo.mjs tests/browser/profile-import.mjs tests/browser/group-create.mjs tests/browser/connection-move.mjs tests/browser/domain-list-save.mjs tests/browser/quality.mjs tests/browser/traffic.mjs tests/browser/dns.mjs && npm run test:browser:dns-api:built",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src --max-warnings 0",
    "generate": "node scripts/generate-client.mjs",
    "test:e2e": "node --test tests/browser/profile-live.mjs",
    "test:e2e:domain-list": "node --test tests/browser/domain-list-live.mjs",
    "test:browser:dns-api": "npm run build && npm run test:browser:dns-api:built",
    "test:browser:dns-api:built": "HESTIA_DNS_BROWSER_TEST=1 go -C ../backend test -count=1 -timeout=2m -run \"^TestDNS(Panel|Worker)Playwright$\" -v ./internal/panel ./internal/dnsservice"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/forms": "21.2.26",
    "@angular/platform-browser": "21.2.26",
    "@angular/router": "21.2.26",
    "@primeuix/themes": "2.0.3",
    "primeng": "21.1.10",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler": "21.2.26",
    "@angular/compiler-cli": "21.2.26",
    "@eslint/js": "^10.0.0",
    "angular-eslint": "21.4.0",
    "eslint": "^10.14.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
