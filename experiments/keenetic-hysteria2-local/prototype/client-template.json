      "password": "__PASSWORD__",
      "tls": {
        "enabled": true,
        "server_name": "hestia-hy2.test",
        "certificate_path": "__CA_CERT__",
        "insecure": false
      }
    }
  ],
  "route": {"final": "local-hy2-out"}
}
