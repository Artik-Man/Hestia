{
  "log": {"level": "debug"},
  "inbounds": [
    {
      "type": "socks",
      "tag": "loopback-socks",
      "listen": "127.0.0.1",
      "listen_port": 19330
    }
  ],
  "outbounds": [
    {
      "type": "hysteria2",
      "tag": "local-hy2-out",
