#!/bin/sh
# Verify the KN-1012 target with the shared Go RCI client before opkg extracts package files.

set -eu

if [ "$(id -u)" != 0 ]; then
    printf '%s\n' 'Hestia package installation requires root' >&2
    exit 1
fi

if [ "$(uname -m)" != aarch64 ]; then
    printf '%s\n' 'Hestia requires an AArch64 Entware target' >&2
    exit 1
fi

if [ ! -x /opt/bin/opkg ] || [ ! -x /opt/bin/busybox ]; then
    printf '%s\n' 'Hestia requires Entware opkg and busybox' >&2
    exit 1
fi

if [ -x /opt/etc/init.d/S52keen-mvp ]; then
    printf '%s\n' 'Remove the standalone keen-mvp package before installing Hestia; both packages cannot own OpkgTun0' >&2
    exit 1
fi

case "$0" in
    */*) script_dir=${0%/*} ;;
    *) script_dir=. ;;
esac
script_dir=$(CDPATH= cd "$script_dir" && pwd)
if [ ! -x "$script_dir/keenetic-preflight" ]; then
    printf '%s\n' 'Hestia Go target preflight is missing' >&2
    exit 1
fi

exec "$script_dir/keenetic-preflight"
