[Unit]
Description=Hestia scheme 3 web panel
Wants=network-online.target
After=network-online.target

[Service]
User=hestia-panel
Group=hestia-panel
StateDirectory=hestia-quality-settings
StateDirectoryMode=0755
SupplementaryGroups=hestia-snapshot
ExecStart=/opt/hestia-scheme3-app/current/hestia-panel -listen @LAN_IP@:8080 -assets /opt/hestia-scheme3-app/current/browser -snapshot /etc/hestia/snapshot.json -enable-domain-lists -enable-group-create -enable-group-order -enable-group-delete -enable-exit-move -enable-awg
Restart=on-failure
RestartSec=3
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/run/amneziawg /etc/hestia /run/hestia-awg /run/hestia-install.lock -/etc/NetworkManager/system-connections
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
