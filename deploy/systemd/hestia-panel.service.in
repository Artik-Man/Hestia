[Unit]
Description=Hestia web panel
Wants=network-online.target
After=network-online.target

[Service]
User=hestia-panel
Group=hestia-panel
SupplementaryGroups=hestia-snapshot
ExecStart=/usr/local/bin/hestia-panel -listen @PANEL_LISTEN@ -assets /usr/local/share/hestia-panel/current -snapshot /etc/hestia/snapshot.json -enable-bindings -enable-group-order -enable-awg
Restart=on-failure
RestartSec=3s
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/etc/hestia /run/hestia-awg /run/hestia-install.lock
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
