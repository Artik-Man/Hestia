[Unit]
Description=Hestia userspace WireGuard/AmneziaWG connector
Wants=network-online.target
After=network-online.target
Before=hestia-sing-box.service hestia.service

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/hestia -awg-runtime
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/etc/hestia
ReadWritePaths=/run/hestia-awg
CapabilityBoundingSet=CAP_NET_ADMIN CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_CHOWN
UMask=0077
